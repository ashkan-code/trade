# Bitunix read-only API credentials
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Market-data endpoints (kline, tickers) are public — no keys required.
# Keys are only needed if you later add authenticated endpoints (order history, etc.).
# Leave blank for now if you only need historical OHLCV downloads.

BITUNIX_API_KEY=
BITUNIX_API_SECRET=

# Base URL (no trailing slash)
BITUNIX_BASE_URL=https://fapi.bitunix.com
